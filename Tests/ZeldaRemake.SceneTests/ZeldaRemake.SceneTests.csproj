<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TestFramework>GdUnit4</TestFramework>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\SceneTests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc6" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude Godot-generated C# files from compilation. -->
    <Compile Remove=".godot/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\PushableBlocks\Fixtures\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Features\PushableBlocks\Fixtures\PushableBlockFixture.tscn" />
    <None Include="features\rooms\fixtures\RoomTransitionFixture.tscn" />
  </ItemGroup>

</Project>
