<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TestFramework>GdUnit4</TestFramework>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\SceneTests.runsettings</RunSettingsFilePath>

    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test framework -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc6" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared application logic -->
    <ProjectReference Include="..\..\Core\ZeldaRemake.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scene tests -->
    <Compile Include="Features\**\*.cs" />
    <Compile Include="Helpers\**\*.cs" />

    <!-- Godot-specific production code via directory junctions -->
    <Compile Include="Scripts\**\*.cs" />
    <Compile Include="Services\**\*.cs" />

    <!-- GdUnit4 generated test runner -->
    <Compile Include="gdunit4_testadapter_v5\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test scene fixtures -->
    <None Include="Features\PushableBlocks\Fixtures\PushableBlockFixture.tscn" />
    <None Include="Features\Rooms\Fixtures\RoomTransitionFixture.tscn" />
  </ItemGroup>

</Project>
